# ============================================================
# KCEMS · environment variables
# Copy to .env.local for local dev; set the same keys in the
# Vercel dashboard (Project → Settings → Environment Variables).
# NEVER commit real values. NEVER paste the service-role key in chat.
# ============================================================

# --- Supabase (server-side / Vercel serverless API only) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=          # secret — Supabase → Project Settings → API → service_role

# --- Auth ---
JWT_SECRET=                          # long random string; signs login session tokens

# --- Front-end (safe to expose; used for direct bill-photo uploads) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=              # Supabase → Project Settings → API → anon/public

# --- Data source toggle ---
# "local"    = seeded in-browser demo (default, no backend needed)
# "supabase" = live backend via the Vercel /api layer
VITE_DATA_SOURCE=local
