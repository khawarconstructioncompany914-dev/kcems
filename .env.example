# ============================================================
# KCEMS · environment variables
# Copy to .env.local for local dev; set the same keys in the
# Vercel dashboard (Project → Settings → Environment Variables).
# NEVER commit real values. NEVER paste the service-role key in chat.
# ============================================================

# --- Database (REQUIRED — the whole /api layer talks to this) ---
# Supabase → Project Settings → Database → Connection pooling → URI (port 6543).
# Use the POOLER here: serverless functions open and drop connections constantly
# and would exhaust a direct connection limit.
# Vercel's Supabase integration sets this for you; without it every API call
# fails, which is the single most common way to get a deployment that builds
# fine and then does nothing.
POSTGRES_URL=

# The DIRECT connection (port 5432), for anything the pooler cannot do:
# migrations, pg_dump, pg_restore, and the scripts in scripts/.
POSTGRES_URL_NON_POOLING=

# --- Supabase (server-side / Vercel serverless API only) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=          # secret — Supabase → Project Settings → API → service_role

# --- Auth ---
JWT_SECRET=                          # long random string; signs login session tokens
                                     # changing it signs everybody out

# --- Front-end (safe to expose; used for direct bill-photo uploads) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=              # Supabase → Project Settings → API → anon/public

# --- Data source toggle ---
# "local"    = seeded in-browser demo (default, no backend needed)
# "supabase" = live backend via the Vercel /api layer
VITE_DATA_SOURCE=local

# --- First-time setup only ---
# /api/setup applies the migrations. It is DISABLED (404) unless SETUP_TOKEN is
# set, because it runs DDL against production — never leave it reachable with no
# token. Unset it again once the schema is applied.
SETUP_TOKEN=

# Starting password for the demo roster, used ONLY when /api/setup seeds an
# empty database. There is deliberately no default: this repository is public,
# so a hardcoded seed password is a published way in. Must be 8+ characters, and
# every seeded account is forced to change it at first login.
# Leave blank on a real deployment — you do not want the demo roster at all.
SEED_PASSWORD=
